# Copy to .env.docker, chmod 600, then edit privately. Never commit actual values.
# Production must use its real HTTPS origin, without a path or trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
SITE_TALK_PORT=3000
# Required: stable 32 random bytes encoded as Base64. Back up separately from data.
AI_SETTINGS_ENCRYPTION_KEY=
# Recommended: leave API key empty and register it in the administrator settings.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Web Push: all three must be configured together.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
