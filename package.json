{
  "name": "site-talk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs apps/web/tests/*.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:seed": "node scripts/test-users.mjs",
    "db:local": "wrangler d1 migrations apply site-talk --local",
    "db:remote": "wrangler d1 migrations apply site-talk --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "react": "^19.1.0", "react-dom": "^19.1.0" },
  "devDependencies": { "@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@cloudflare/workers-types": "latest", "typescript": "^5.9.0", "vite": "^7.0.0", "wrangler": "^4.0.0", "@playwright/test": "^1.55.0" }
}
